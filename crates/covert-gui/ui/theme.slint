export global Theme {
    in-out property <color> background: #FFFFFF;
    in-out property <color> surface: #F8F9FA;
    in-out property <color> surface-hover: #F1F3F5;
    in-out property <color> surface-active: #E9ECEF;
    in-out property <color> border: #E9ECEF;
    in-out property <color> border-focus: #2563EB;
    in-out property <color> text-primary: #1A1D20;
    in-out property <color> text-secondary: #6C757D;
    in-out property <color> text-muted: #ADB5BD;
    in-out property <color> accent-emerald: #10B981;
    in-out property <color> accent-emerald-light: #ECFDF5;
    in-out property <color> accent-emerald-border: #A7F3D0;
    in-out property <color> accent-blue: #2563EB;
    in-out property <color> accent-blue-hover: #1D4ED8;
    in-out property <color> accent-danger: #EF4444;
    in-out property <color> accent-danger-light: #FEF2F2;
    in-out property <color> accent-warning: #F59E0B;
    in-out property <string> font-family: "Inter, Segoe UI, sans-serif";
    in-out property <length> radius-sm: 4px;
    in-out property <length> radius-md: 6px;
    in-out property <length> radius-lg: 8px;
    in-out property <length> radius-xl: 12px;
}

export component StyledButton inherits Rectangle {
    in-out property <string> text: "Button";
    in-out property <string> kind: "primary"; // "primary" | "secondary" | "danger" | "emerald" | "ghost"
    in-out property <bool> enabled: true;
    in-out property <length> btn-height: 38px;
    in-out property <length> font-size: 13px;
    callback clicked();

    border-radius: Theme.radius-md;
    height: root.btn-height;
    clip: true;

    background: !root.enabled ? #E5E7EB :
        touch.pressed ? (
            root.kind == "primary" ? Theme.accent-blue-hover :
            root.kind == "danger" ? #DC2626 :
            root.kind == "emerald" ? #059669 :
            root.kind == "secondary" ? Theme.surface-active : #E5E7EB
        ) : touch.has-hover ? (
            root.kind == "primary" ? #1D4ED8 :
            root.kind == "danger" ? #F87171 :
            root.kind == "emerald" ? #34D399 :
            root.kind == "secondary" ? Theme.surface-hover : #F3F4F6
        ) : (
            root.kind == "primary" ? Theme.accent-blue :
            root.kind == "danger" ? Theme.accent-danger :
            root.kind == "emerald" ? Theme.accent-emerald :
            root.kind == "secondary" ? Theme.surface : Colors.transparent
        );

    border-width: (root.kind == "secondary") ? 1px : 0px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        spacing: 6px;

        Text {
            text: root.text;
            font-family: Theme.font-family;
            font-size: root.font-size;
            font-weight: 500;
            color: !root.enabled ? #9CA3AF :
                (root.kind == "primary" || root.kind == "danger" || root.kind == "emerald") ? #FFFFFF :
                Theme.text-primary;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component StyledInput inherits Rectangle {
    in-out property <string> label: "";
    in-out property <string> placeholder: "";
    in-out property <string> text <=> input.text;
    in-out property <bool> is-password: false;
    in-out property <bool> enabled: true;
    in-out property <string> error-message: "";
    callback edited(string);
    callback accepted();

    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: root.error-message != "" ? Theme.accent-danger :
                  input.has-focus ? Theme.border-focus : Theme.border;
    background: Theme.background;
    height: 62px;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 2px;

        if root.label != "": Text {
            text: root.label;
            font-family: Theme.font-family;
            font-size: 11px;
            font-weight: 600;
            color: root.error-message != "" ? Theme.accent-danger : Theme.text-secondary;
        }

        input := TextInput {
            text: "";
            font-family: Theme.font-family;
            font-size: 13px;
            color: Theme.text-primary;
            input-type: root.is-password ? InputType.password : InputType.text;
            enabled: root.enabled;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(); }

            if self.text == "" && !self.has-focus: Text {
                text: root.placeholder;
                font-family: Theme.font-family;
                font-size: 13px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
    }
}

export component CategoryBadge inherits Rectangle {
    in-out property <string> text: "";
    in-out property <bool> active: false;
    callback clicked();

    border-radius: Theme.radius-sm;
    background: root.active ? Theme.accent-blue : Theme.surface;
    border-width: 1px;
    border-color: root.active ? Theme.accent-blue : Theme.border;
    height: 26px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;

        Text {
            text: root.text;
            font-family: Theme.font-family;
            font-size: 11px;
            font-weight: 600;
            color: root.active ? #FFFFFF : Theme.text-secondary;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}
