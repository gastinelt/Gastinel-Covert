export global Theme {
    in-out property <color> background: #ffffff;
    in-out property <color> surface: #ffffff;
    in-out property <color> surface-hover: #ffffff;
    in-out property <color> surface-active: #ffffff;
    in-out property <color> border: #d9d9d9;
    in-out property <color> border-focus: #111111;
    in-out property <color> text-primary: #111111;
    in-out property <color> text-secondary: #6b6b6b;
    in-out property <color> text-muted: #6b6b6b;
    in-out property <color> accent-danger: #c62828;
    in-out property <color> accent-danger-light: #ffffff;
    in-out property <string> font-family: "Inter";
    in-out property <length> radius-sm: 0px;
    in-out property <length> radius-md: 0px;
    in-out property <length> radius-lg: 0px;
    in-out property <length> radius-xl: 0px;
}

export component StyledButton inherits Rectangle {
    in-out property <string> text: "Button";
    in-out property <string> kind: "primary"; // "primary" | "secondary" | "danger" | "ghost"
    in-out property <bool> enabled: true;
    in-out property <length> btn-height: 38px;
    in-out property <length> font-size: 13px;
    callback clicked();

    border-radius: 0px;
    height: root.btn-height;
    clip: true;

    background: !root.enabled ? Theme.background :
        (root.kind == "primary" || root.kind == "emerald") ?
            (touch.has-hover ? Theme.background : Theme.text-primary) :
            (touch.has-hover ? Theme.text-primary : Theme.background);

    border-width: 1px;
    border-color: !root.enabled ? Theme.border :
        (root.kind == "primary" || root.kind == "emerald" || root.kind == "danger" || touch.has-hover) ?
            Theme.text-primary : Theme.border;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        spacing: 6px;

        Text {
            text: root.text;
            font-family: Theme.font-family;
            font-size: root.font-size;
            font-weight: 500;
            color: !root.enabled ? Theme.text-secondary :
                (root.kind == "primary" || root.kind == "emerald") ?
                    (touch.has-hover ? Theme.text-primary : Theme.background) :
                    (touch.has-hover ? Theme.background : Theme.text-primary);
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component StyledInput inherits Rectangle {
    in-out property <string> label: "";
    in-out property <string> placeholder: "";
    in-out property <string> text <=> input.text;
    in-out property <bool> is-password: false;
    in-out property <bool> enabled: true;
    in-out property <string> error-message: "";
    callback edited(string);
    callback accepted();

    border-radius: 0px;
    border-width: 1px;
    border-color: root.error-message != "" ? Theme.accent-danger :
                  input.has-focus ? Theme.border-focus : Theme.border;
    background: Theme.background;
    height: 62px;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 2px;

        if root.label != "": Text {
            text: root.label;
            font-family: Theme.font-family;
            font-size: 11px;
            font-weight: 600;
            color: root.error-message != "" ? Theme.accent-danger : Theme.text-secondary;
        }

        input := TextInput {
            text: "";
            font-family: Theme.font-family;
            font-size: 13px;
            color: Theme.text-primary;
            input-type: root.is-password ? InputType.password : InputType.text;
            enabled: root.enabled;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(); }

            if self.text == "" && !self.has-focus: Text {
                text: root.placeholder;
                font-family: Theme.font-family;
                font-size: 13px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
    }
}

export component CategoryBadge inherits Rectangle {
    in-out property <string> text: "";
    in-out property <bool> active: false;
    callback clicked();

    border-radius: 0px;
    background: root.active ? Theme.text-primary : Theme.background;
    border-width: 1px;
    border-color: root.active ? Theme.text-primary : Theme.border;
    height: 26px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;

        Text {
            text: root.text;
            font-family: Theme.font-family;
            font-size: 11px;
            font-weight: 600;
            color: root.active ? Theme.background : Theme.text-secondary;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}
